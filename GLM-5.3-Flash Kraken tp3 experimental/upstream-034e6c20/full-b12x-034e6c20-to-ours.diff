+@dsl_user_op
+def packed_decode_trellis_sqg_state_global_to_e4m3x8(
+    win_a,
+    win_b,
+    state_blob_addr,
+    bits: int = 3,
+    k2_q8h4: bool = False,
+    *,
+    loc=None,
+    ip=None,
+):
+    """Decode eight profile-5 windows via the global 58 KiB state blob.
