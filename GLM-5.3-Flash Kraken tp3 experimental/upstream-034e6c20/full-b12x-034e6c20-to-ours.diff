+_SQG_FP16_D3L_DESCRIPTORS_DEVICE: dict[tuple[str, int | None], torch.Tensor] = {}
+
+
+def _sqg_fp16_d3l_descriptors_device(
+    device_type: str,
+    device_index: int | None,
+) -> torch.Tensor:
