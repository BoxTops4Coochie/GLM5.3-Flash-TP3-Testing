-def lut_e4m3_decode_ranks_torch(ranks: torch.Tensor) -> torch.Tensor:
-    """Map ranks to E4M3 bytes through the value law."""
-
-    rank = ranks.to(torch.int64) & 0xFFFF
-    negative = rank < 0x8000
