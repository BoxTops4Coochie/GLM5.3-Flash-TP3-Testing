+# SPDX-License-Identifier: Apache-2.0
+"""GLM-5.3-Flash TP3 decode GEMM selection for unquantized BF16 on SM120.
+
+Mirrors ``deepseek_v32/nvidia/glm52_low_latency_gemm.py``: for the small
+per-rank BF16 projections that cuBLAS serves with a split-K pair (GEMM +
+``splitKreduce``) or an SM80 WMMA fallback at decode batch sizes, route the
+measured-faster shapes through the CuTe shape-dynamic skinny GEMM. The plan
+below is the M set where the skinny kernel beat cuBLAS by >3% in
+``optimization/dcp3-20260910/bench_linear_shapes.py`` on RTX PRO 6000
+(TP3 physical geometry). Every other (shape, M) keeps cuBLAS.
+``VLLM_GLM53_LOW_LATENCY_GEMM=0`` disables the swap.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+from torch import nn
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+from vllm.model_executor.kernels.linear.cute_dsl.skinny_gemm import (
+    SkinnyGemmConfig,
+    shape_dynamic_skinny_gemm,
+)
+from vllm.model_executor.layers.linear import LinearBase, UnquantizedLinearMethod
+from vllm.platforms import current_platform
+
+logger = init_logger(__name__)
+
+# (N, K) per TP3 rank -> decode M values where the skinny GEMM wins.
+GLM53_TP3_PLAN: dict[tuple[int, int], frozenset[int]] = {
+    (8598, 4096): frozenset({1, 2, 4, 8}),  # KDA in_proj_qkvgfab
+    (128, 4096): frozenset({1, 2, 4}),  # KDA g_a_proj, indexer wk
+    (4096, 2816): frozenset({1, 2}),  # KDA o_proj
+    (2048, 4096): frozenset({1, 2}),  # DSA fused_qkv_a_proj
+    (6144, 1536): frozenset({1}),  # DSA q_b_proj
+    (4096, 6144): frozenset({1, 2, 4}),  # DSA o_proj
+    (4096, 1536): frozenset({1, 2, 4}),  # indexer wq_b
+    (32, 4096): frozenset({1, 2, 4, 8}),  # indexer weights_proj (cuBLAS WMMA 13 us)
+    (1366, 8192): frozenset({1, 2, 4, 8}),  # MTP eh_proj
+}
+
+
+def _enabled(dtype: torch.dtype | None) -> bool:
+    # This is a pure-performance path: any unexpected configuration must fall
+    # back to cuBLAS rather than abort model construction.
+    if os.environ.get("VLLM_GLM53_LOW_LATENCY_GEMM", "1") == "0":
+        return False
+    if dtype != torch.bfloat16 or not current_platform.is_cuda():
+        return False
+    if torch.cuda.get_device_capability()[0] != 12:
+        return False
+    return shape_dynamic_skinny_gemm.is_available()
+
+
+def _row_major(t: torch.Tensor) -> bool:
+    return t.dim() == 2 and t.stride() == (t.shape[1], 1)
+
+
+def _configs(n: int, k: int, ms: frozenset[int]) -> set[SkinnyGemmConfig]:
+    return {shape_dynamic_skinny_gemm._config(m, n, k) for m in ms}
+
+
+class GLM53LowLatencyLinearMethod(UnquantizedLinearMethod):
+    def __init__(self, ms: frozenset[int]) -> None:
+        super().__init__()
+        self._ms = ms
+
+    def apply(
+        self,
+        layer: nn.Module,
+        x: torch.Tensor,
+        bias: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        weight = layer.weight
+        if (
+            bias is None
+            and x.shape[0] in self._ms
+            and not envs.VLLM_BATCH_INVARIANT
+            and x.dtype == torch.bfloat16
+            and weight.dtype == torch.bfloat16
+            and _row_major(x)
+            and _row_major(weight)
+            and x.shape[1] == weight.shape[1]
+        ):
+            return shape_dynamic_skinny_gemm(x, weight)
+        return super().apply(layer, x, bias)
+
+
+def enable_glm53_low_latency_gemm(module: nn.Module, dtype: torch.dtype | None) -> None:
+    if not _enabled(dtype):
+        return
+    warmup: set[SkinnyGemmConfig] = set()
+    swapped = 0
+    for child in module.modules():
+        if (
+            not isinstance(child, LinearBase)
+            or type(child.quant_method) is not UnquantizedLinearMethod
+        ):
+            continue
+        weight = getattr(child, "weight", None)
+        if weight is None or weight.dim() != 2 or weight.dtype != torch.bfloat16:
+            continue
+        ms = GLM53_TP3_PLAN.get((int(weight.shape[0]), int(weight.shape[1])))
+        if ms is None:
+            continue
+        child.quant_method = GLM53LowLatencyLinearMethod(ms)
+        warmup |= _configs(int(weight.shape[0]), int(weight.shape[1]), ms)
+        swapped += 1
+    if warmup:
+        shape_dynamic_skinny_gemm.request_warmup_configs(torch.bfloat16, warmup)
+    logger.info_once(
+        "GLM-5.3 low-latency GEMM: %d BF16 projections routed to the CuTe skinny "
+        "GEMM for their measured decode batch sizes (%d warmup configs)",
+        swapped,
+        len(warmup),
+    )
