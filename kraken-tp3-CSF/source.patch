+        raise ValueError(
+            "GLM-5.3 DFlash TP3 requires physical/logical Q/KV heads "
+            f"36/9 from 32/8, got {physical[0]}/{physical[1]} from "
+            f"{logical[0]}/{logical[1]}."
+        )
+    return logical
+
