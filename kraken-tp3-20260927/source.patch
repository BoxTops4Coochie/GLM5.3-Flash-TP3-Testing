+    text_config = draft_model_config.hf_text_config
+    draft_shapes = (
+        ("num_attention_heads", 32),
+        ("num_key_value_heads", 8),
+        ("vocab_size", 154880),
+    )
+    for name, expected in draft_shapes:
+        _require_shape(text_config, name, expected)
