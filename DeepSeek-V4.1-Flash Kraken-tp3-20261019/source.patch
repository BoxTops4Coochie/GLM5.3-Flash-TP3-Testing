+def _online_csf_enabled(source_format: str, quant_mode: str) -> bool:
+    """DS41_B12X_CSF=1 compresses native MXFP4 expert scales while preparing."""
+    return (
+        os.environ.get("DS41_B12X_CSF", "0") == "1"
+        and source_format == "fp4_e8m0_k32"
+        and quant_mode in ("w4a8_mx", "w4a16")
+    )
